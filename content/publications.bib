@article{Xiang2026Deep,
  selected={true},
  title = {Deep Learning-Aided Laser Doppler Velocimeter-Inertial Measurement Unit Fusion for Robust Vehicle Localization in Global Navigation Satellite Systems-Denied Environments},
  author = {Xiang, Zhiyi and Wang, Qi and Nie, Xiaoming and Zhou, Jian},
  year = 2026,
  month = feb,
  journal = {Engineering Applications of Artificial Intelligence},
  volume = {165},
  pages = {113425},
  issn = {0952-1976},
  langid = {english},
  % preview={EAAI2026.png},
  abstract = {Achieving reliable and precise vehicle localization is crucial for modern autonomous systems, particularly in Global Navigation Satellite Systems (GNSS)-denied environments where low-cost Micro-Electro-Mechanical Systems (MEMS) Inertial Measurement Units (IMUs) suffer from rapid error accumulation. This paper proposes a deep learning-aided Laser Doppler Velocimeter-Inertial Measurement Unit fusion approach for robust vehicle localization by integrating two symmetrically mounted dual-beam Laser Doppler Velocimeters (LDVs) with a MEMS IMU. Two specialized Long Short-Term Memory (LSTM) networks are employed to regress vehicle yaw velocity and lateral velocity by fusing LDV and IMU outputs. To improve robustness, an LDV outlier handling strategy and an LSTM prediction reliability detection method are developed to mitigate the influence of abnormal sensor measurements and unreliable network outputs. The LDV-derived velocities and LSTM-predicted yaw and lateral velocities are fused with MEMS IMU data using a Lie group-based Kalman filter. Experimental results from vehicle tests demonstrate that the proposed method significantly reduces positioning errors under prolonged GNSS-denied conditions and outperforms existing LDV-based integration methods.},
  description={A deep learning-aided dual-beam LDV and MEMS IMU fusion framework for robust vehicle localization in GNSS-denied environments using LSTM-based velocity prediction, outlier handling, reliability detection, and Lie group-based Kalman filtering.},
  keywords={MEMS IMU, Dual-beam Laser Doppler Velocimeter, Long Short-Term Memory Network, Yaw Velocity, Vehicle Localization, GNSS-denied Environments},
  doi = {10.1016/j.engappai.2025.113425}
}

@article{Xiang2025Faulttolerant,
  title = {A Fault-Tolerant Sins/Dual {{2D-LDV}} Tightly Coupled Integration Scheme for Autonomous Vehicle Navigation},
  author = {Xiang, Zhiyi and Wang, Qi and Jin, Shilong and Nie, Xiaoming and Zhou, Jian},
  year = 2025,
  month = oct,
  journal = {Scientific Reports},
  volume = {15},
  number = {1},
  pages = {35671},
  issn = {2045-2322},
  langid = {english},
  publisher = {Nature Publishing Group},
  doi = {10.1038/s41598-025-19574-7},
  abstract = {Strapdown inertial navigation systems (SINS) integrated with two-dimensional laser Doppler velocimeters (2D-LDVs) provide a promising autonomous navigation solution for land vehicles in GNSS-denied environments. However, vehicle sideslip and outliers in 2D-LDV measurements can significantly degrade navigation performance. This paper proposes a fault-tolerant SINS/Dual-2D-LDV tightly coupled integration scheme, in which two 2D-LDVs are integrated with SINS to construct a redundant measurement model using raw LDV measurements and the vehicle lateral zero-velocity constraint. A Local Outlier Factor (LOF)-based fault detection method is introduced to identify both 2D-LDV measurement outliers and violations of the zero-velocity constraint. Furthermore, an adaptive filter is designed to dynamically adjust the filter gain according to the LOF value, thereby mitigating the influence of anomalies on the integrated navigation solution. The effectiveness and robustness of the proposed method are validated through two long-distance vehicle experiments. Experimental results show that the proposed scheme achieves superior horizontal and vertical positioning accuracy compared with traditional methods, while the LOF-based fault detection method demonstrates higher sensitivity and effectiveness than the conventional residual chi-squared detection method.},
  description={A fault-tolerant tightly coupled SINS/Dual-2D-LDV integration scheme for robust autonomous vehicle navigation in GNSS-denied environments.},
  keywords={Autonomous Navigation, SINS/Dual-2D-LDV Tightly Coupled Integration, Local Outlier Factor, Adaptive Filter},
  copyright = {2025 The Author(s)}
}

@article{Xiang2025Further,
  selected={true},
  title = {Further Application of Pitch Independent Laser Doppler Velocimeter in Land Vehicle Autonomous Navigation},
  author = {Xiang, Zhiyi and Wang, Qi and Huang, Rong and Jin, Shilong and Nie, Xiaoming and Zhou, Jian},
  year = 2025,
  month = mar,
  journal = {IEEE Transactions on Vehicular Technology},
  volume = {74},
  number = {7},
  pages = {1--13},
  issn = {0018-9545},
  langid = {english},
  doi = {10.1109/TVT.2025.3546606},
  abstract = {The strapdown inertial navigation system (SINS) and pitch-independent laser Doppler velocimeter (PI-LDV) integration represents a traditional architecture for land vehicle autonomous navigation, yet its altitude accuracy is limited by the PI-LDV's conventional one-dimensional velocity output. This paper further exploits the optical path structure of the PI-LDV to obtain two-dimensional velocity information and proposes two improved integration schemes: a SINS/PI-LDV loosely coupled integration method and a SINS/PI-LDV tightly coupled integration method, both considering potential laser beam fluctuations. To enhance measurement utilization and reduce the influence of sensor noise and outliers, a displacement increment measurement model is developed for the SINS/PI-LDV integrated navigation system. The proposed methods are validated through multiple vehicle field tests, including long-distance and short-distance experiments using high-precision and medium-precision inertial measurement units. Experimental results demonstrate that the proposed approaches significantly outperform traditional SINS/PI-LDV integration, especially in height estimation accuracy, and show stronger practical applicability for cost-sensitive land vehicle navigation in GNSS-denied environments.},
  description = {A further application of pitch-independent laser Doppler velocimeter for land vehicle autonomous navigation, proposing loosely and tightly coupled SINS/PI-LDV integration methods with a displacement increment measurement model to improve positioning, particularly height accuracy.},
  keywords = {Integrated Navigation, Strapdown Inertial Navigation System, SINS, Pitch-Independent Laser Doppler Velocimeter, PI-LDV, Displacement Increment Measurement, Land Vehicle Autonomous Navigation},
  copyright = {https://ieeexplore.ieee.org/Xplorehelp/downloads/license-information/IEEE.html}
}

@article{Xiang_2024,
  author = {Zhiyi Xiang and Qi Wang and Shilong Jin and Xiaoming Nie and Jian Zhou},
  title = {Online calibration method for SINS/LDV integrated navigation system based on left group error definition},
  journal = {Measurement Science and Technology},
  year = {2024},
  volume = {35},
  number = {5},
  month = {Feb},
  pages = {055106},
  issn = {0957-0233},
  langid = {english},
  doi = {10.1088/1361-6501/ad24b8},
  abstract = {The integration of strapdown inertial navigation system (SINS) and laser Doppler velocimeter (LDV) is a reliable technology for land vehicle positioning. To ensure the best positioning performance of the SINS/LDV integrated navigation system, accurate calibration is necessary. However, the error model accuracy of traditional calibration methods is seriously affected by large misalignment angles, which reduces filtering accuracy and consistency and ultimately degrades calibration performance. This paper introduces Lie group theory into the calibration of SINS/LDV integrated navigation systems for the first time. Based on the left group error definition in Lie groups, three calibration models are derived in the Earth-centered Earth-fixed frame using velocity, displacement increment, and dead reckoning position as observation information. The proposed models are capable of handling large initial misalignment angles. Two long-distance vehicle experiments demonstrate that the Lie group-based calibration methods achieve performance comparable to traditional methods under normal conditions, while showing significant advantages under large initial attitude deviations. In addition, displacement increment and dead reckoning position observations improve calibration performance compared with velocity observations.},
  description={An online calibration method for SINS/LDV integrated navigation systems based on Lie group left error definitions, designed to improve robustness under large initial misalignment angles.},
  keywords={Strapdown Inertial Navigation System, Laser Doppler Velocimeter, Integrated Navigation, Calibration, Lie Group},
  url = {https://dx.doi.org/10.1088/1361-6501/ad24b8}
}

@article{10758723,
  selected={true},
  title={LSTM-Assisted SINS/2D-LDV Tightly Coupled Integration Approach Using Local Outlier Factor and Adaptive Filter}, 
  year={2024},
  month = {nov},
  journal={IEEE Transactions on Instrumentation and Measurement}, 
  author={Xiang, Zhiyi and Wang, Qi and Nie, Xiaoming and Jin, Shilong and Zhou, Jian},
  volume={74},
  number={},
  pages={1-15},
  issn = {0018-9456},
  langid = {english},
  doi={10.1109/TIM.2024.3502729},
  abstract = {The tightly coupled integration of strapdown inertial navigation system (SINS) and 2-D laser Doppler velocimeter (2D-LDV) improves the robustness of land autonomous navigation by directly using raw 2D-LDV beam measurements. However, its performance can be degraded by prolonged failures of individual or dual 2D-LDV beams and by violations of the vehicle lateral zero-velocity constraint. To address these issues, this paper proposes an LSTM-assisted SINS/2D-LDV tightly coupled integration approach incorporating local outlier factor (LOF) detection and an adaptive filter. The LOF method is used to evaluate the anomaly degree of system measurements, while preconstructed and classified historical normal datasets improve detection accuracy and reduce computational burden. The LSTM network predicts both 2D-LDV measurements and vehicle lateral velocity, replacing anomalous measurements to mitigate their adverse effects. Furthermore, an adaptive filter adjusts the measurement noise covariance matrix to suppress potential errors introduced by LSTM predictions. Vehicle-mounted experiments demonstrate that the proposed method achieves satisfactory navigation performance under normal conditions as well as prolonged single- and dual-beam failures of the 2D-LDV.},
  description={An LSTM-assisted SINS/2D-LDV tightly coupled integration method using local outlier factor detection and adaptive filtering to improve the robustness and accuracy of land autonomous navigation under LDV anomalies and lateral constraint violations.},
  keywords={Strapdown Inertial Navigation System, 2-D Laser Doppler Velocimeter, Tightly Coupled Integration, Long Short-Term Memory Network, Local Outlier Factor, Adaptive Filter, Land Autonomous Navigation},
  year={2024}
}

@article{10328480,
  title={A Robust Online Calibration Method for SINS/LDV Integrated Navigation System Based on Position Observation}, 
  journal={IEEE Sensors Journal}, 
  year={2024},
  month = {Jan},
  volume={24},
  number={1},
  author={Xiang, Zhiyi and Wang, Qi and Huang, Rong and Jin, Shilong and Nie, Xiaoming and Zhou, Jian},
  pages={895-908},
  issn = {1530-437X},
  langid = {english},
  abstract = {The integration of strapdown inertial navigation system (SINS) with a laser Doppler velocimeter (LDV) has been proven to be a reliable technique for land vehicle localization. To enhance the positioning accuracy of the SINS/LDV integrated navigation system, accurate calibration is essential. This paper proposes a robust position observation-based calibration method for the SINS/LDV integrated navigation system. The calibration process is divided into two phases: coarse calibration and fine calibration. In the coarse calibration phase, an analytical calibration method is adopted. In the fine calibration phase, a robust Kalman filter is first designed to obtain accurate vehicle attitude and position, and then another Kalman filter is constructed using an LDV error propagation model based on position observation to further calibrate the SINS/LDV integrated navigation system. To reduce the influence of nonholonomic constraint assumption violation during vehicle turning, z-axis gyroscope and LDV velocity outputs are used to detect vehicle direction changes and compensate for the lateral velocity of the LDV in the LDV frame. The proposed method is verified through two groups of vehicle field tests. The results show that the proposed method achieves higher calibration accuracy and stronger robustness than three compared methods. In two tests with total mileages of 76.9 km and 65.34 km, the maximum dead reckoning horizontal positioning errors of the calibrated SINS/LDV integrated navigation system are 6.61 m and 10.91 m, respectively.},
  description={A robust online calibration method for SINS/LDV integrated navigation systems based on position observation, designed to improve calibration accuracy and robustness under GNSS outliers and vehicle turning conditions.},
  keywords={SINS/LDV Integrated Navigation, Online Calibration, Laser Doppler Velocimeter, Position Observation, Robust Kalman Filter},
  doi={10.1109/JSEN.2023.3333898}
}

@article{Huang_2024,
  doi = {10.1088/1361-6501/ad21d6},
  url = {https://dx.doi.org/10.1088/1361-6501/ad21d6},
  year = {2024},
  month = {Feb},
  publisher = {IOP Publishing},
  volume = {35},
  number = {5},
  pages = {056301},
  author = {Rong Huang and Qi Wang and Zhiyi Xiang and Xiaoming Nie and Jian Zhou and Hui Luo},
  title = {A water track laser Doppler velocimeter for use in underwater navigation},
  issn = {0957-0233},
  langid = {english},
  abstract = {Doppler velocity log (DVL) is usually employed to suppress the divergency of the Strapdown Inertial Navigation System (SINS) in underwater navigation, which is not concealable due to high transmittance for acoustic wave in the water. To conduct underwater navigation task with high concealment, a differential laser Doppler velocimeter (LDV) working at water track mode is integrated with SINS in this paper. The developed LDV measures the advance velocity of the underwater carrier with respect to the surrounding water in underwater navigation scenario with advantages of high concealment, high real-time performance, high update rate, light weight, and small dimension. A dynamic river test was conducted to validate the underwater navigation performance of SINS/LDV integrated system. The experimental results show that during the voyage of 4493s and 5271.8 m, the maximum horizontal positioning errors of the proposed SINS/LDV integrated underwater navigation system is 27.8 m and the relative position error is less than 0.6% with respect to total distance. Therefore, the water track LDV is practical to aid SINS in underwater navigation environment.},
  description={A water track laser Doppler velocimeter for high-concealment underwater navigation, experimentally validated as an aiding sensor for SINS in dynamic river tests.},
  keywords={laser Doppler velocimeter, SINS, LDV, underwater navigation, water track},
  journal = {Measurement Science and Technology}
}

@article{Xiang_2023,
 doi = {10.1088/1361-6501/acf2b4},
 url = {https://dx.doi.org/10.1088/1361-6501/acf2b4},
 year = {2023},
 month = {Aug},
 publisher = {IOP Publishing},
 volume = {34},
 number = {12},
 pages = {125116},
 issn = {0957-0233},
 langid = {english},
 author = {Zhiyi Xiang and Tao Zhang and Qi Wang and Shilong Jin and Xiaoming Nie and Chengfang Duan and Jian Zhou},
 title = {A SINS/GNSS/2D-LDV integrated navigation scheme for unmanned ground vehicles},
 abstract = {In recent years, unmanned autonomous driving technology has attracted increasing attention from people, and become a research hotspot. Currently, the integration of strapdown inertial navigation system (SINS) and global navigation satellite systems (GNSSs) is the most common and effective navigation and positioning scheme for unmanned ground vehicles (UGVs) and unmanned aerial vehicles. However, this integrated system is unable to maintain a reliable positioning solution in challenging environments due to the inherent weakness of GNSS signals and the accumulation of SINS positioning errors over time. To address this issue, this paper proposes an integrated scheme based on an asynchronous Kalman filter for SINS, GNSS and two-dimensional (2D) laser Doppler velocimeter (LDV). In the proposed scheme, the SINS and 2D-LDV are tightly coupled to improve the robustness of the integrated system, and the error parameters between the 2D-LDV and the SINS are calibrated in real time during the validity of the GNSS signal. In addition, the designed asynchronous Kalman filter method evaluates the validity of the GNSS and 2D-LDV measurements in real time based on Mahalanobis distance of innovation vector and statistical property principle. Two groups of long-distance, high-mobility vehicle experiments conducted in challenging environments verify the validity of the proposed scheme. The experimental results show that the proposed SINS/GNSS/2D-LDV integrated navigation scheme has good environmental adaptability and reliability, and can maintain high horizontal and vertical positioning accuracy despite frequent GNSS signal failures, which can meet the needs of UGVs.},
 description={A robust integrated navigation scheme for unmanned ground vehicles based on asynchronous Kalman filtering and tightly coupled SINS/GNSS/2D-LDV integration.},
 keywords={Strapdown Inertial Navigation System, Laser Doppler Velocimeter, SINS/GNSS/2D-LDV Integrated Navigation Scheme},
 journal = {Measurement Science and Technology}
}

@ARTICLE{10251461,
  selected={true},
  author={Xiang, Zhiyi and Wang, Qi and Huang, Rong and Jin, Shilong and Nie, Xiaoming and Zhou, Jian},
  journal={IEEE Transactions on Instrumentation and Measurement}, 
  title={Online Calibration Method for Pitch-Independent Laser Doppler Velocimeter Based on Improved Integrated Navigation Model}, 
  year={2023},
  month={Sep},
  volume={72},
  number={},
  pages={1-13},
  issn = {0018-9456},
  langid = {english},
  abstract = {The integrated navigation system comprising a strapdown inertial navigation system (SINS) and a laser Doppler velocimeter (LDV) is a promising solution for autonomous terrestrial navigation. This paper proposes an online calibration method for pitch-independent LDV (PI-LDV) based on an improved integrated navigation model. Existing PI-LDV applications mainly use its one-dimensional velocity output while neglecting the two subvelocities provided by its two beams. To fully exploit the structural advantages of PI-LDV, three calibration models are developed: a loosely integrated calibration model using two-dimensional velocity derived from the subvelocities, a tightly integrated calibration model that directly estimates the included-angle error between the two beams, and an ultratightly integrated calibration model that directly uses the original beam measurements with an additional virtual beam constraint. Vehicle field tests demonstrate that the proposed models significantly improve the positioning accuracy of SINS/PI-LDV integrated navigation, especially in height estimation. Among the three models, the ultratightly integrated calibration model achieves the best overall calibration performance and robustness.},
  description={An online calibration method for pitch-independent laser Doppler velocimeter based on improved SINS/PI-LDV integrated navigation models using two subvelocity measurements.},
  keywords={Calibration, Integrated Navigation, Pitch-Independent Laser Doppler Velocimeter, PI-LDV, Strapdown Inertial Navigation System, SINS, Two-Dimensional Velocity},
  doi={10.1109/TIM.2023.3315425}
}

@ARTICLE{Huang:23,
  author = {Rong Huang and Qi Wang and Zhiyi Xiang and Xiaoming Nie and Jian Zhou and Hui Luo},
  journal={Chinese Optics Letters}, 
  number = {9},
  pages = {090005},
  publisher = {Optica Publishing Group},
  title = {Water track laser Doppler velocimeter [Invited]},
  volume = {21},
  month = {Sep},
  year = {2023},
  issn = {1671-7694},
  langid = {english},
  doi={10.3788/COL202321.090005},
  abstract = {A water track laser Doppler velocimeter (LDV) is developed for underwater navigation applications, offering high update rate, high real-time performance, high concealment, light weight, and compact dimensions. The proposed system measures the advance velocity of an underwater vehicle relative to the surrounding water using differential laser Doppler velocimetry with a forward-scattering optical configuration. A 532 nm laser source is employed to improve signal acquisition in the blue-green optical window of ocean water, and a compact C-shaped watertight structure is designed for underwater deployment. River experiments conducted in the Liuyang River demonstrate that the velocity measured by the LDV is strongly correlated with the reference velocity obtained from GNSS, with a Pearson correlation coefficient of 0.9969. After linear calibration, the water track LDV achieves an accuracy of 96.4% when the vehicle velocity relative to the ground exceeds 0.25 m/s. These results indicate that the proposed water track LDV is a promising velocity sensor for aiding strapdown inertial navigation systems in underwater autonomous navigation.},
  description={A compact water track laser Doppler velocimeter for measuring underwater vehicle velocity relative to surrounding water and aiding strapdown inertial navigation systems.},
  keywords={Laser Doppler Velocimeter, Water Track, Underwater Navigation, Strapdown Inertial Navigation System},
  url = {https://opg.optica.org/col/abstract.cfm?URI=col-21-9-090005}
}

@ARTICLE{9841423,
  author={Xiang, Zhiyi and Wang, Qi and Huang, Rong and Xi, Chongbin and Nie, Xiaoming and Zhou, Jian},
  journal={IEEE Sensors Journal}, 
  title={A Fast Robust In-Motion Alignment Method for Laser Doppler Velocimeter-Aided Strapdown Inertial Navigation System}, 
  year={2022},
  month={Aug},
  volume={22},
  number={17},
  pages={17254-17265},
  issn = {1530-437X},
  langid = {english},
  abstract = {With ultra-high velocity measurement accuracy, laser Doppler velocimeter (LDV) is promising to replace the odometer for providing vehicle velocity information in land integrated navigation. This paper investigates fast in-motion initial alignment for LDV-aided strapdown inertial navigation systems (SINS). To address the degradation of alignment accuracy and convergence speed caused by LDV installation misalignment angles and scale factor error, a Robust Double Gain Square-Root Unscented Quaternion Estimator (RDGSR-USQUE) method is proposed. The method incorporates unknown parameter errors into the process and measurement models, introduces a double gain structure using posterior measurement residual information to improve convergence speed, and enhances the traditional Unscented Quaternion Estimator (USQUE) by improving noise resistance, convergence performance under large misalignment angles, and covariance matrix positive definiteness. The proposed method estimates and compensates unknown LDV-related parameter errors while estimating attitude, thereby improving the accuracy of the process and measurement models and ultimately enhancing attitude estimation accuracy. Vehicle field tests demonstrate that the proposed method achieves higher alignment accuracy, faster convergence speed, and stronger robustness than comparison methods, while satisfactorily estimating LDV installation misalignment angles and scale factor error.},
  description={A fast and robust in-motion initial alignment method for LDV-aided SINS using a robust double gain square-root unscented quaternion estimator to improve alignment accuracy, convergence speed, and robustness under LDV installation and scale factor errors.},
  keywords={Laser Doppler Velocimeter, In-Motion Initial Alignment, Strapdown Inertial Navigation System, Installation Misalignment Angle, Scale Factor Error, Robust Double Gain Square-Root Unscented Quaternion Estimator},
  doi={10.1109/JSEN.2022.3191120}
}

@article{Xiang_2022,
 doi = {10.1088/1361-6501/ac37e9},
 url = {https://dx.doi.org/10.1088/1361-6501/ac37e9},
 year = {2021},
 month = {Dec},
 publisher = {IOP Publishing},
 volume = {33},
 number = {3},
 pages = {035001},
 issn = {0957-0233},
 langid = {english},
 author = {Zhiyi Xiang and Qi Wang and Rong Huang and Chongbin Xi and Xiaoming Nie and Jian Zhou},
 title = {In-motion initial alignment method for a laser Doppler velocimeter-aided strapdown inertial navigation system based on an adaptive unscented quaternion H-infinite filter},
 abstract = {With its advantages of high velocity measurement accuracy and fast dynamic response, the laser Doppler velocimeter (LDV) is expected to replace the odometer (OD) in combination with a strapdown inertial navigation system (SINS) to give a higher-precision integrated navigation system. Since an LDV has higher velocity measurement accuracy and data update frequency than an OD and Doppler velocity log, an LDV is used for the first time in this paper to aid a SINS in in-motion alignment. Considering the approximation used in the alignment model, sensor uncertainty noise during motion, and unknown noise parameters in the filtering process, an adaptive unscented quaternion H-infinite estimator (AUSQUHE) is proposed. The proposed AUSQUHE method combines the advantages of an unscented quaternion estimator and an H-infinite filter, thereby achieving high robustness. An adaptive H-infinite filtering threshold and an adaptive measurement noise covariance matrix are introduced to improve adaptability to changing environments and accelerate error convergence. The performance of the proposed method is verified by vehicle field tests with both normal and noise-disturbed LDV signals. The results demonstrate that the proposed method achieves higher alignment accuracy, faster convergence speed, and stronger robustness than four compared methods.},
 description={A robust in-motion initial alignment method for LDV-aided strapdown inertial navigation systems using an adaptive unscented quaternion H-infinite estimator.},
 keywords={laser Doppler velocimeter (LDV), strapdown inertial navigation system (SINS), in-motion alignment, adaptive unscented quaternion H-infinite estimator (AUSQUHE)},
 journal = {Measurement Science and Technology}
}

@article{Xiang:21,
 author = {Zhiyi Xiang and Qi Wang and Rong Huang and Chongbin Xi and Xiaoming Nie and Jian Zhou},
 journal = {Applied Optics},
 number = {26},
 pages = {7869--7877},
 publisher = {Optica Publishing Group},
 title = {Position observation-based calibration method for an LDV/SINS integrated navigation system},
 volume = {60},
 month = {Sep},
 year = {2021},
 issn = {1559-128X},
 langid = {english},
 url = {https://opg.optica.org/ao/abstract.cfm?URI=ao-60-26-7869},
 abstract = {With the advantages of high velocity measurement accuracy and fast dynamic response, the laser Doppler velocimeter (LDV) is expected to replace the odometer in strapdown inertial navigation system (SINS)-based integrated navigation. However, LDV scale factor error and misalignment angles between the LDV and inertial measurement unit can significantly degrade navigation accuracy. This paper proposes a robust GNSS-aided calibration method for an LDV/SINS integrated navigation system based on position observation. Unlike conventional calibration approaches that rely on velocity observations, the proposed method constructs observation vectors using attitude information from an adaptive Kalman filter-based GNSS/SINS integrated navigation system, LDV velocity outputs, and GNSS position outputs. The LDV scale factor error is determined by the ratio of the moduli of two observation vectors, while the misalignment angles are estimated using Davenport's q-method. Vehicle field tests under both normal GNSS conditions and GNSS outlier interference validate the accuracy and robustness of the proposed method. The calibrated LDV/SINS dead reckoning system achieves horizontal position errors below 0.0314% and 0.1033% of the traveled mileage in the two tests, respectively.},
 description={A robust GNSS-aided position observation-based calibration method for estimating LDV scale factor error and misalignment angles in an LDV/SINS integrated navigation system.},
 keywords={Laser Doppler Velocimeter, Strapdown Inertial Navigation System, Integrated Navigation, Calibration, Position Observation, Adaptive Kalman Filter, Davenport's q-method},
 doi = {10.1364/AO.430866}
}

@article{Xi2022Online,
  title = {Online Calibration Technology for a One-Dimensional Laser {{Doppler}} Velocimeter Based on a Strapdown Inertial Navigation System},
  author = {Xi, Chongbin and Wang, Qi and Nie, Xiaoming and Huang, Rong and Xiang, Zhiyi and Zhou, Jian and Jin, Shilong},
  year = 2022,
  month = feb,
  journal = {Applied Optics},
  volume = {61},
  number = {5},
  issn = {1559-128X},
  langid = {english},
  pages = {1229},
  abstract = {In an integrated navigation system consisting of a laser Doppler velocimeter (LDV) and a strapdown inertial navigation system (SINS), accurate calibration of the LDV is essential for improving navigation performance. This paper proposes an online calibration method for a one-dimensional LDV based on SINS. The method first uses the highly accurate output information available during the early stage of inertial navigation to perform coarse calibration of the LDV scale factor and installation angle. A Kalman filter is then employed to compensate and correct the coarse calibration results, enabling high-precision online calibration without relying on external satellite navigation information. Simulations and onboard vehicle experiments demonstrate that the proposed method effectively improves dead-reckoning accuracy. Experimental results show that the relative distance error is less than 0.02%, confirming the feasibility, accuracy, and practical value of the proposed online calibration technology.},
  description={An online calibration method for a one-dimensional laser Doppler velocimeter using strapdown inertial navigation system information and Kalman-filter-based compensation.},
  keywords={Laser Doppler Velocimeter, Strapdown Inertial Navigation System, Online Calibration, Kalman Filter, Integrated Navigation}
  doi = {10.1364/AO.446235}
}

@article{ZhangTao2025CheZaiSINS,
  title = {{车载SINS/1D-LDV杆臂误差在线标定算法}},
  author = {Tao Zhang and Xiaoming Nie and Jian Zhou and Qi Wang and Zhiyi Xiang},
  year = 2025,
  journal = {国防科技大学学报},
  volume = {47},
  number = {5},
  issn = {1001-2486},
  langid = {zh},
  abstract = {Aiming at the lever-arm velocity error caused by different installation positions of a one-dimensional laser Doppler velocimeter (1D-LDV) and a strapdown inertial navigation system (SINS) in vehicle-mounted integrated navigation systems, this paper proposes an online calibration algorithm based on Kalman filtering to estimate and compensate the mounting lever-arm error. By introducing a reference point whose velocity direction remains aligned with the carrier's direction of motion, the traditional lever-arm velocity error model is improved to accurately describe the actual relationship between the measured velocities of the 1D-LDV and SINS. A 23-dimensional Kalman filter model is established to estimate SINS errors and LDV error parameters, including scale factor error, installation angle error, and lever-arm error. Vehicle experimental results demonstrate that the proposed algorithm can effectively calibrate the lever-arm error between the 1D-LDV and SINS. After lever-arm error compensation, the horizontal positioning errors in two experimental trials are reduced from 8.80 m and 6.60 m to 7.07 m and 5.48 m, respectively, indicating an improvement in navigation and positioning accuracy.},
  description={An online Kalman-filter-based calibration algorithm for compensating lever-arm errors in vehicle-mounted SINS/1D-LDV integrated navigation systems.},
  keywords={Integrated Navigation, One-Dimensional Laser Doppler Velocimeter, Strapdown Inertial Navigation System, Lever-Arm Error, Calibration Algorithm},
  pages = {86--93}
}
